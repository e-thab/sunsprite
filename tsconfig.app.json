{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/**/*.ts",
    "src/**/*.tsx",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports. This block is the single source of
    // truth for aliases: Vite's `resolve.alias` and the api-codegen's module
    // resolution are both derived from it (see scripts/aliases.ts), so adding
    // one here is all that's needed. Entries that don't name a real source
    // directory must be excluded there via TYPE_ONLY_PATTERNS.
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./src/assets/api/*"],

      // Nuxt
      "#build/ui/*": [
        "./node_modules/.nuxt-ui/ui/*"
      ]
    },

    "types": ["vite/client"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
